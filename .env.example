# Signuture frontend environment template
# Copy to .env for local development. Never commit real secrets.

# Backend API base URL used by the shared Axios client.
# Required.
VITE_API_URL=http://localhost:3000

# WebSocket base URL used for GitHub sync and generation progress.
# Optional; defaults to ws://localhost:3000 in the GitHub hook.
VITE_WS_URL=ws://localhost:3000

# Optional PostHog browser analytics. Leave blank to disable locally.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
